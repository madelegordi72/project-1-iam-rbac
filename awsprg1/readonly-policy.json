{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadOnlyEC2AndCloudWatch",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*",
                "cloudwatch:GetMetricData",
                "cloudwatch:ListMetrics"
            ],
            "Resource": [
                "*"
            ]
        }
    ]
}